[Unit]
Description=wagoya WhatsApp assistant (C1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wagoya
WorkingDirectory=/home/wagoya/wagoya
ExecStart=/home/wagoya/wagoya/wagoya
Environment=PATH=/home/wagoya/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
