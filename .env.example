# wagoya settings. Copy to .env and fill in. Codes in brackets point to DECISIONS.md.

# ============================================================
# WhatsApp
# ============================================================

# Owners, comma-separated: digits with country code, no + or spaces (B3, B9),
# e.g. WHITELIST=6281234567890,6289876543210
WHITELIST=

# Optional: the BOT's own number, digits with country code. Links with an
# 8-character pairing code instead of a QR (B10)
# PAIR_NUMBER=6289876543210

# Name used in prompts and mentions
BOT_NAME=Claude

# Groups: the bot replies when @mentioned or replied to (B1).
# DMs: owners need no prefix; this old prefix is still stripped.
TRIGGER=!$

# ============================================================
# Model providers (G1, G5, L13)
# ============================================================
# DEFAULT_PROVIDER is used at startup. Owners can switch in chat with
# "!provider <name>" until the next restart. Any provider whose key is set
# can be switched to.

# anthropic, openrouter or openai
DEFAULT_PROVIDER=anthropic

# --- anthropic: Claude. Set ONE of the two auth keys (A5) ---
# API key (console.anthropic.com), billed per use. Wins if both are set.
ANTHROPIC_API_KEY=
# Or a subscription token from `claude setup-token`; needs the claude CLI.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BIN=claude
ANTHROPIC_MODEL=claude-haiku-5-5
# Reasoning effort isn't set here: every provider starts at medium, and an
# owner changes it in chat with !reasoning, saved in the database (Y1).

# --- openrouter: any OpenRouter model (openrouter.ai/keys) ---
# Also used for embeddings (EMBED_MODEL), whatever the provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# --- openai: any OpenAI-compatible API, e.g. abliteration.ai ---
# LLM_MODEL is required when LLM_BASE_URL is set.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
# Context
# ============================================================

# Recent messages per chat sent as context (B5)
HISTORY_LIMIT=64
# Important-context memories added per request (B12)
MEMORY_RESULTS=8
# Max input tokens per request (B17). Capped at 96000 per model call (W2);
# 16000 of it is kept for tool rounds.
CONTEXT_TOKENS=96000
# Embedding model for hybrid fact search (J2), via OpenRouter (needs
# OPENROUTER_API_KEY). About $0.02 per million tokens; "off" = keywords only.
EMBED_MODEL=openai/text-embedding-3-small

# ============================================================
# Tools
# ============================================================

# Web search and page reading with the bot's own tools (W1)
WEB_TOOLS=true
# Local open-websearch daemon behind them (deploy installs it); empty = web off
WEBSEARCH_URL=http://127.0.0.1:3210
# Deep search (W8): each web_search reads the top pages and a cheap model
# digests them; needs OPENROUTER_API_KEY, else plain snippets.
# Backend at startup: builtin (the daemon above) or openrouter (OpenRouter's
# search and page reader); owners switch with !web until restart.
WEB_BACKEND=builtin
# Model that writes the digest (OpenRouter slug)
RESEARCH_MODEL=deepseek/deepseek-v4.1-flash-1017
# Page text gathered per search, in tokens (hard ceiling 72000)
RESEARCH_RAW_TOKENS=64000
# Digest size per search, in tokens (max 16000); 0 or off = snippets only
RESEARCH_TOKENS=8000

# http_request for public APIs (everyone who can trigger the bot) plus MCP
# server tools (owners only) (I1, I2)
API_TOOLS=true
# MCP servers file, Claude Desktop format (I3). Default: DATA_DIR/mcp.json
#   {"mcpServers": {"github": {"url": "https://api.githubcopilot.com/mcp/",
#     "headers": {"Authorization": "Bearer ghp_..."}}}}
# MCP_CONFIG=data/mcp.json
# Stored API keys for http_request (I4, L1): send "!key" to the bot in a DM,
# or edit DATA_DIR/api_keys.json (chmod 600) and restart.

# ============================================================
# Pacing
# ============================================================

# Minimum gap between ANY two outgoing messages; extras queue (B18)
SEND_INTERVAL=3s
# Per-chat cooldown for the ACCESS DENIED reply (B14)
DENY_COOLDOWN=1m

# ============================================================
# Storage
# ============================================================

# Session, chat window and memories live here; keep it secret (C3)
DATA_DIR=data
