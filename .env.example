# Which model provider to use (G1): anthropic (Claude, default) or openrouter
PROVIDER=anthropic
# OpenRouter key (openrouter.ai/keys); needed when PROVIDER=openrouter
OPENROUTER_API_KEY=

# --- Claude auth (A5): set ONE of these ---
# Anthropic API key (console.anthropic.com), billed per use. Used if set.
ANTHROPIC_API_KEY=
# Or a subscription token from `claude setup-token`. Needs the claude CLI on the host.
CLAUDE_CODE_OAUTH_TOKEN=
# Path to the claude CLI (only for the token mode)
CLAUDE_BIN=claude

# Whitelisted people, comma-separated (B3, B9): phone numbers with country
# code (+62 812-3456-7890 is fine). The bot resolves them to WhatsApp LIDs.
# Raw LIDs also work as "123456789@lid".
WHITELIST=

# Groups: the bot replies when @mentioned or when someone replies to it (B1).
# DMs: whitelisted users need no prefix; this old prefix is still stripped.
TRIGGER=!$

# Optional: the BOT's number (digits with country code) -> link with an
# 8-character pairing code instead of a QR (B10)
# PAIR_NUMBER=6289876543210

BOT_NAME=Claude
# Model ID. Claude: claude-haiku-5-5 (default). OpenRouter: a slug such as
# deepseek/deepseek-v4.1-flash-1017 (default when PROVIDER=openrouter)
MODEL=claude-haiku-5-5
EFFORT=low
# Recent messages per chat sent as context (B5)
HISTORY_LIMIT=64
# Important-context memories added per request (B12)
MEMORY_RESULTS=8
# Max input tokens per request: system + memories + transcript + request + image (B17)
CONTEXT_TOKENS=128000
# Let the model search the web and open links (E1, G3); search is billed per use
WEB_TOOLS=true
# API tools (I1, I2): http_request for public APIs (anyone who can trigger the
# bot), plus the tools of MCP servers in MCP_CONFIG (whitelisted requesters only).
API_TOOLS=true
# MCP servers, Claude Desktop format (I3). Default: DATA_DIR/mcp.json. Example:
# {"mcpServers": {"github": {"url": "https://api.githubcopilot.com/mcp/",
#   "headers": {"Authorization": "Bearer ghp_..."}},
#  "fs": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/srv/share"]}}}
# MCP_CONFIG=data/mcp.json
# Stored API keys for http_request, whitelisted requesters only (I4): put
# {"host": {"Header": "value"}} in DATA_DIR/api_keys.json (chmod 600), e.g.
# {"tasks.example.com": {"Authorization": "Bearer <token>"}}. Restart after editing.
# Embedding model for hybrid fact search (J2), via OpenRouter, so it needs
# OPENROUTER_API_KEY (also with PROVIDER=anthropic). About $0.02 per million
# tokens; "off" disables it and search uses keywords only.
EMBED_MODEL=openai/text-embedding-3-small
# Global minimum gap between ANY two outgoing messages; extras queue (B18)
SEND_INTERVAL=3s
# Per-chat cooldown for the ACCESS DENIED reply (B14)
DENY_COOLDOWN=1m
# Session, chat window and memories live here; keep it secret (C3)
DATA_DIR=data
